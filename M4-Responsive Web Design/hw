<!DOCTYPE html>
<html>
<head>
  <style>
        .container {
            display: grid;

            grid-template-columns: 1fr 2fr 1fr;

            grid-template-rows: 80px 100px 100px 80px;

            gap: 10px;
        }

        header {
            grid-column: 1 / 4;
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }

        .menu1 {
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }

        main {
            grid-column: 2;
            grid-row: 2 / 4;

            border: 2px solid black;
            text-align: center;
            padding: 50px;
        }

        .slide1 {
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }

        .menu2 {
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }

        .slide2 {
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }

        footer {
            grid-column: 1 / 4;
            border: 2px solid black;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

    <div class="container">

        <header>
            Header
        </header>

        <div class="menu1">
            Menu 1
        </div>

        <main>
            Main Content
        </main>

        <div class="slide1">
            Slide 1
        </div>

        <div class="menu2">
            Menu 2
        </div>

        <div class="slide2">
            Slide 2
        </div>

        <footer>
            Footer
        </footer>

    </div>

</body>
</html>
