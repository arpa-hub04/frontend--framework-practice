<!DOCTYPE html>
<html>
<head>
    <title>Rowspan and Colspan</title>
</head>

<body>

    <h1>Student Result</h1>

    <table border="1">

        <tr>
            <th>Name</th>
            <th colspan="2">Marks</th>
        </tr>

        <tr>
            <td>Rahim</td>
            <td>Math</td>
            <td>English</td>
        </tr>

        <tr>
            <td rowspan="2">Karim</td>
            <td>80</td>
            <td>75</td>
        </tr>

        <tr>
            <td>90</td>
            <td>85</td>
        </tr>

    </table>

</body>
</html>
